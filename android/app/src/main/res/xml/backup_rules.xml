<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup rules (API <= 30).

  We back up ONLY the drift database (every app setting lives in it too, so this
  one file is a complete backup of the user's data). Using <include> restricts
  the backup to exactly this file, which:
    - keeps it tiny and always under the 25 MB Auto Backup cap, and
    - avoids backing up regenerated engine data (app_flutter/flutter_assets),
      which is ~90 MB in debug builds and would otherwise blow the quota.

  Progress/PR photos are intentionally NOT backed up (size); a future manual
  export can cover those. The DB uses a rollback journal (no WAL), so the single
  .sqlite file is a self-consistent backup.
-->
<full-backup-content>
    <include domain="root" path="app_flutter/gym_dude.sqlite" />
</full-backup-content>
